import os, re, json
from datetime import datetime

base = "C:/Users/min/Desktop/mathedu"

# 1) New/changed _regen_*.py scripts (vs .regen_state.json)
state = json.load(open(base + "/._regen_cron_state.json"))
print("[1] _regen_*.py 스크립트 현황")
regen_files = sorted([f for f in os.listdir(base) if f.startswith("_regen_") and f.endswith(".py")])
print(f"  개수: {len(regen_files)}개")

# 2) Board HTML 파일 최신 생성일
html_files = []
for root, dirs, files in os.walk(base + "/board"):
    for f in files:
        if f.endswith(".html"):
            html_files.append(os.path.join(root, f))
html_files.sort(key=lambda p: os.path.getmtime(p), reverse=True)
print(f"[2] board/*.html 최신 5개:")
for p in html_files[:5]:
    mt = datetime.fromtimestamp(os.path.getmtime(p)).strftime("%Y-%m-%d %H:%M")
    print(f"  {mt}  {os.path.basename(p)}")

# 3) __site_feed.xml 항목 수
feed = open(base + "/__site_feed.xml", encoding="utf-8").read()
items = re.findall(r"<item>", feed)
print(f"[3] __site_feed.xml 항목 수: {len(items)}")

# 4) __site_index.json (site index) 최신 상태
