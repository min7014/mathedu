 "19": {
  "L1": {
   "q": "속도함수 $v(t)=-t^2+t+2$ 에 대하여 $0\\le t\\le 2$ 구간에서의 이동거리를 구하시오.",
   "a": "$\\int_0^2(-t^2+t+2)dt=\\left[-\frac{t^3}{3}+\frac{t^2}{2}+2t\right]_0^2=\frac{10}{3}$"
  },
  "L2": {
   "q": "$v(t)=0$ 이 되는 첫 시각 $t>0$ 을 구하시오.",
   "a": "$-t^2+t+2=0 \\Rightarrow (t-2)(t+1)=0 \\Rightarrow t=2$"
  },
  "L3": {
   "q": "본문: $t>3$ 에서 $v(t)=k(t-3)-4$ 일 때, 위치가 $s(0)=0$, $s(t_2)=1$ 이고 $t_2$ 에서 방향전환하면 $k$ 를 구하시오.",
   "a": "$k=16$ (이전 풀이 참조)"
  }
 },
 "24": {
  "L1": {
   "q": "두 사건 $A,B$ 가 배반할 때 $P(A\\cup B)$ 를 $P(A),P(B)$ 로 나타내시오.",
   "a": "$P(A\\cup B)=P(A)+P(B)$ (교집합이 공집합)"
  },
  "L2": {
   "q": "$P(A^C)=\\dfrac56$ 이면 $P(A)$ 를 구하시오.",
   "a": "$P(A)=1-P(A^C)=1-\frac56=\frac16$"
  },
  "L3": {
   "q": "배반이고 $P(A\\cup B)=\frac34$ 일 때 $P(B^C)$ 를 구하시오.",
   "a": "$P(B)=\frac34-\frac16=\frac7{12}$, $P(B^C)=\frac5{12}$"
  }
 }
